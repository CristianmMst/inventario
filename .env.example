# Copiar a .env y ajustar. Nunca subir .env al repositorio.
ENTORNO=desarrollo
DATABASE_URL=postgresql+asyncpg://inventario:inventario@localhost:5432/inventario
JWT_SECRETO=cambiar-por-un-secreto-aleatorio-de-al-menos-32-bytes
IMAGENES_DIR=./datos/imagenes
IMAGENES_SECRETO=cambiar-por-otro-secreto-aleatorio-de-al-menos-32-bytes
# Asistente (RF-AST). La API key de Retell solo vive en el servidor.
RETELL_API_KEY=
RETELL_AGENT_ID=
URL_PUBLICA_API=https://api.mikelabs.com.co
