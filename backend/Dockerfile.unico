# Imagen autónoma: PostgreSQL y la API en un solo contenedor, sin variables de entorno
# obligatorias. Pensada para entornos donde solo se puede subir una imagen.
#   docker build -f Dockerfile.unico -t cristianmmst/inventario-backend:1.0.1 -t cristianmmst/inventario-backend:latest .
#   docker run -d -p 8091:8091 -v inventario:/datos cristianmmst/inventario-backend:latest
# La base de datos, las fotos de productos y los secretos generados viven en /datos.
FROM python:3.12-alpine AS construccion
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/
WORKDIR /srv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY . .
RUN uv sync --frozen --no-dev

FROM python:3.12-alpine
RUN apk add --no-cache postgresql17 postgresql17-contrib \
    && adduser -S -D -u 10001 -h /srv app \
    && mkdir -p /datos && chown app /datos
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 \
    ENTORNO=produccion IMAGENES_DIR=/datos/imagenes PORT=8091 WEB_CONCURRENCY=2
WORKDIR /srv
COPY --from=construccion /opt/venv /opt/venv
COPY --from=construccion --chown=app /srv /srv
COPY --chmod=755 arranque.sh /usr/local/bin/arranque.sh
USER app
VOLUME /datos
EXPOSE 8091
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ[\"PORT\"]}/api/v1/salud', timeout=4)"
CMD ["arranque.sh"]
